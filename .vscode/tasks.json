{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build workspace C files",
      "type": "cppbuild",
      "command": "/usr/bin/gcc",
      "args": [
        "-x",
        "objective-c",
        "-g",
        "*.c",
        "-o",
        "${workspaceFolder}/main",
        "-I/opt/homebrew/include",
        "-L/opt/homebrew/lib",
        "-lraylib",
        "-licns",
        "-framework", "OpenGL",
        "-framework", "Cocoa",
        "-framework", "IOKit",
        "-framework", "CoreVideo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run main",
      "type": "shell",
      "command": "./main",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["Build workspace C files"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}